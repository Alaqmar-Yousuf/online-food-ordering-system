<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane
    minHeight="700.0" prefWidth="1100.0"
    stylesheets="@../css/styles.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.foodorder.client.controller.RestaurantDashboardController">

    <!-- ── TOP NAV ── -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="62.0" styleClass="header-bar">
            <padding><Insets left="28.0" right="28.0"/></padding>
            <Label styleClass="title-text" style="-fx-font-size: 20px;" text="🍔  FoodPanda — Restaurant Dashboard"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="subtitle-text">
                <HBox.margin><Insets right="16.0"/></HBox.margin>
            </Label>
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="secondary-button" text="Logout"/>
        </HBox>
    </top>

    <!-- ── BODY ── -->
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0"/>
            </BorderPane.margin>

            <!-- STAT CARDS -->
            <HBox spacing="18.0">
                <VBox HBox.hgrow="ALWAYS" spacing="6.0" alignment="CENTER_LEFT" styleClass="food-card">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                    <Label style="-fx-font-size:12px;-fx-text-fill:#999;" text="🔔  Active Orders"/>
                    <Label fx:id="activeOrdersLabel"
                           style="-fx-font-size:34px;-fx-font-weight:bold;-fx-text-fill:#D70F64;" text="…"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6.0" alignment="CENTER_LEFT" styleClass="food-card">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                    <Label style="-fx-font-size:12px;-fx-text-fill:#999;" text="💰  Today's Revenue"/>
                    <Label fx:id="todayRevenueLabel"
                           style="-fx-font-size:34px;-fx-font-weight:bold;-fx-text-fill:#2E7D32;" text="…"/>
                </VBox>
            </HBox>

            <!-- ORDERS TABLE -->
            <VBox VBox.vgrow="ALWAYS" spacing="15.0" styleClass="food-card">
                <padding><Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/></padding>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="title-text" style="-fx-font-size:18px;" text="Live Orders"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label style="-fx-text-fill:#999;-fx-font-size:12px;" text="Auto-refreshing every 5s"/>
                    <Region prefWidth="20"/>
                    <Button mnemonicParsing="false" onAction="#loadOrders" styleClass="secondary-button" text="↻  Refresh Now"/>
                </HBox>

                <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colOrderId"    text="Order ID"   prefWidth="90"  minWidth="70"/>
                        <TableColumn fx:id="colUser"       text="Customer"   prefWidth="160" minWidth="100"/>
                        <TableColumn fx:id="colTotal"      text="Total"      prefWidth="110" minWidth="80"/>
                        <TableColumn fx:id="colStatus"     text="Status"     prefWidth="150" minWidth="100"/>
                        <TableColumn fx:id="colAction"     text="Action"     prefWidth="200" minWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label style="-fx-text-fill:#AAAAAA;-fx-font-size:14px;"
                               text="No incoming orders right now."/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
