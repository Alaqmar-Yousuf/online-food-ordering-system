<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.media.MediaView?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodorder.client.controller.LoginController"
      stylesheets="@../css/styles.css"
      minHeight="700.0" minWidth="1100.0">

    <!-- ════════════════════════════════════
         LEFT PANEL — Login Form
         ════════════════════════════════════ -->
    <VBox alignment="CENTER" minWidth="440.0" prefWidth="480.0" maxWidth="500.0" HBox.hgrow="NEVER"
          style="-fx-background-color: #1a1a2e; -fx-padding: 60 50;">
        <spacing>18.0</spacing>

        <!-- Brand logo area -->
        <VBox alignment="CENTER_LEFT" spacing="4.0">
            <Label text="🍔" style="-fx-font-size: 38px;"/>
            <Label text="FoodPanda"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D70F64;"/>
            <Label text="Order. Track. Enjoy."
                   style="-fx-font-size: 12px; -fx-text-fill: #888; -fx-letter-spacing: 1;"/>
        </VBox>

        <!-- Divider -->
        <Region prefHeight="10.0"/>

        <!-- Title -->
        <VBox spacing="4.0">
            <Label text="Welcome Back 👋"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Login to continue ordering"
                   style="-fx-font-size: 13px; -fx-text-fill: #777;"/>
        </VBox>

        <!-- Username -->
        <VBox spacing="7.0">
            <Label text="Username"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #aaa; -fx-letter-spacing: 1;"/>
            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       style="-fx-background-color: #16213e; -fx-text-fill: white;
                              -fx-prompt-text-fill: #555; -fx-background-radius: 8;
                              -fx-border-color: #2a2a4a; -fx-border-radius: 8;
                              -fx-border-width: 1; -fx-padding: 12 15; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="7.0">
            <Label text="Password"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #aaa; -fx-letter-spacing: 1;"/>
            <PasswordField fx:id="passwordField"
                          promptText="Enter your password"
                          style="-fx-background-color: #16213e; -fx-text-fill: white;
                                 -fx-prompt-text-fill: #555; -fx-background-radius: 8;
                                 -fx-border-color: #2a2a4a; -fx-border-radius: 8;
                                 -fx-border-width: 1; -fx-padding: 12 15; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Error label -->
        <Label fx:id="errorLabel" wrapText="true" visible="false"
               style="-fx-text-fill: #ff4d6d; -fx-font-size: 12px;
                      -fx-background-color: rgba(255,77,109,0.1); -fx-background-radius: 6;
                      -fx-padding: 8 12;"/>

        <!-- Login button -->
        <Button text="LOGIN →" mnemonicParsing="false" onAction="#handleLogin"
                maxWidth="Infinity" prefHeight="48.0"
                style="-fx-background-color: #D70F64; -fx-text-fill: white;
                       -fx-font-size: 15px; -fx-font-weight: bold;
                       -fx-background-radius: 8; -fx-cursor: hand;"/>

        <!-- Signup link -->
        <HBox alignment="CENTER" spacing="5.0">
            <Label text="Don't have an account?"
                   style="-fx-text-fill: #666; -fx-font-size: 13px;"/>
            <Label text="Sign up" onMouseClicked="#goToRegister"
                   style="-fx-text-fill: #D70F64; -fx-cursor: hand; -fx-font-size: 13px;
                          -fx-font-weight: bold;"/>
        </HBox>

        <!-- Hint for admin -->
        <Label text="Admin? Use username: admin / password: admin123"
               wrapText="true"
               style="-fx-text-fill: #3a3a5a; -fx-font-size: 11px; -fx-text-alignment: center;"/>
    </VBox>

    <!-- ════════════════════════════════════
         RIGHT PANEL — Hero Image
         ════════════════════════════════════ -->
    <StackPane fx:id="mediaContainer" HBox.hgrow="ALWAYS" style="-fx-background-color: #0f0f1a;">
        <!-- Background image loaded by controller -->
        <ImageView fx:id="heroImage" fitWidth="700" fitHeight="700"
                   preserveRatio="false" smooth="true" opacity="0.92"/>
        <MediaView fx:id="heroVideo" fitWidth="700" fitHeight="700" preserveRatio="false" opacity="0.92"/>

        <!-- Dark gradient overlay -->
        <VBox alignment="BOTTOM_LEFT"
              style="-fx-background-color: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);">
            <padding><Insets bottom="40.0" left="40.0" right="40.0"/></padding>
            <Label text="🚴  Fast. Fresh. Delivered."
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;
                          -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 8, 0, 0, 2);"/>
            <Label text="Your favourite restaurants, at your doorstep"
                   style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75);"/>
        </VBox>
    </StackPane>

</HBox>
