<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane
    minHeight="700.0" prefWidth="1100.0"
    stylesheets="@../css/styles.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.foodorder.client.controller.AdminController">

    <!-- ── TOP NAV ── -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="62.0" styleClass="header-bar">
            <padding><Insets left="28.0" right="28.0"/></padding>
            <Label styleClass="title-text" style="-fx-font-size: 20px;" text="🍔  FoodPanda — Admin Analytics"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" styleClass="subtitle-text">
                <HBox.margin><Insets right="16.0"/></HBox.margin>
            </Label>
            <Button mnemonicParsing="false" onAction="#refreshAnalytics" styleClass="secondary-button" text="↻  Refresh">
                <HBox.margin><Insets right="16.0"/></HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="secondary-button" text="Logout"/>
        </HBox>
    </top>

    <!-- ── BODY ── -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
            <VBox spacing="20.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="28.0" left="28.0" right="28.0" top="28.0"/>
                </padding>

                <!-- STAT CARDS -->
                <HBox spacing="18.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="6.0" alignment="CENTER_LEFT" styleClass="food-card">
                        <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                        <Label style="-fx-font-size:12px;-fx-text-fill:#999;" text="💰  Total System Revenue"/>
                        <Label fx:id="totalRevenueLabel"
                               style="-fx-font-size:34px;-fx-font-weight:bold;-fx-text-fill:#D70F64;" text="…"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="6.0" alignment="CENTER_LEFT" styleClass="food-card">
                        <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/></padding>
                        <Label style="-fx-font-size:12px;-fx-text-fill:#999;" text="📦  Total Platform Orders"/>
                        <Label fx:id="totalOrdersLabel"
                               style="-fx-font-size:34px;-fx-font-weight:bold;-fx-text-fill:#1565C0;" text="…"/>
                    </VBox>
                </HBox>

                <!-- ANALYTICS TABLES GRID -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    
                    <!-- Restaurant Revenue -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="15.0" styleClass="food-card" VBox.vgrow="ALWAYS" minHeight="300">
                        <padding><Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/></padding>
                        <Label styleClass="title-text" style="-fx-font-size:18px;-fx-text-fill:#D70F64;" text="🏪 Restaurant Revenue"/>
                        <TableView fx:id="revenueTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colRevName" text="Restaurant" prefWidth="180"/>
                                <TableColumn fx:id="colRevOrders" text="Orders" prefWidth="80"/>
                                <TableColumn fx:id="colRevTotal" text="Revenue" prefWidth="120"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="No revenue data."/></placeholder>
                        </TableView>
                    </VBox>

                    <!-- Customer Activity -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="15.0" styleClass="food-card" VBox.vgrow="ALWAYS" minHeight="300">
                        <padding><Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/></padding>
                        <Label styleClass="title-text" style="-fx-font-size:18px;-fx-text-fill:#1565C0;" text="👤 Customer Activity"/>
                        <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colCusName" text="Customer" prefWidth="180"/>
                                <TableColumn fx:id="colCusOrders" text="Orders" prefWidth="80"/>
                                <TableColumn fx:id="colCusSpent" text="Total Spent" prefWidth="120"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="No customer data."/></placeholder>
                        </TableView>
                    </VBox>

                    <!-- Rider Performance -->
                    <VBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" spacing="15.0" styleClass="food-card" VBox.vgrow="ALWAYS" minHeight="300">
                        <padding><Insets bottom="22.0" left="22.0" right="22.0" top="22.0"/></padding>
                        <Label styleClass="title-text" style="-fx-font-size:18px;-fx-text-fill:#8E24AA;" text="🛵 Top Riders (Delivered)"/>
                        <TableView fx:id="riderTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colRidName" text="Rider Name" prefWidth="250"/>
                                <TableColumn fx:id="colRidDeliveries" text="Completed Deliveries" prefWidth="150"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="No deliveries completed yet."/></placeholder>
                        </TableView>
                    </VBox>
                </GridPane>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
