<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodorder.client.controller.CheckoutController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="header-bar">
            <padding><Insets left="24.0" right="24.0"/></padding>
            <Label styleClass="title-text" style="-fx-font-size: 22px;" text="🛒  Checkout"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="secondary-button" text="← Back to Menu"/>
        </HBox>
    </top>

    <!-- Main Content Row -->
    <center>
        <HBox alignment="TOP_CENTER" spacing="24.0" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></BorderPane.margin>

            <!-- ── ORDER SUMMARY ── -->
            <VBox HBox.hgrow="ALWAYS" maxWidth="600.0" minWidth="370.0" spacing="12.0" styleClass="food-card">
                <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/></padding>
                <Label styleClass="title-text" style="-fx-font-size: 18px;" text="Order Summary"/>
                <Label fx:id="restaurantNameLabel"
                       style="-fx-font-size: 13px; -fx-text-fill: #D70F64; -fx-font-weight: bold;" text=""/>
                <Separator/>
                <ListView fx:id="receiptListView" prefHeight="240.0"
                          style="-fx-background-color:transparent;-fx-control-inner-background:transparent;" VBox.vgrow="ALWAYS"/>
                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="title-text" style="-fx-font-size: 16px;" text="Grand Total"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="grandTotalLabel"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #D70F64;" text="\$0.00"/>
                </HBox>
            </VBox>

            <!-- ── PAYMENT FORM (shown before payment) ── -->
            <VBox fx:id="paymentFormBox" HBox.hgrow="ALWAYS" maxWidth="600.0" minWidth="370.0" spacing="18.0" styleClass="food-card">
                <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/></padding>
                <Label styleClass="title-text" style="-fx-font-size: 18px;" text="Payment Details"/>

                <!-- Card icon row -->
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 22px;" text="💳"/>
                    <Label styleClass="subtitle-text" style="-fx-font-size: 12px;" text="Secure SSL Encrypted Payment"/>
                </HBox>

                <VBox spacing="5.0">
                    <Label styleClass="subtitle-text" style="-fx-font-size: 13px;" text="Name on Card"/>
                    <TextField fx:id="nameField" promptText="John Doe" styleClass="custom-text-field"/>
                </VBox>
                <VBox spacing="5.0">
                    <Label styleClass="subtitle-text" style="-fx-font-size: 13px;" text="Card Number"/>
                    <TextField fx:id="cardNumberField" promptText="XXXX  XXXX  XXXX  XXXX" styleClass="custom-text-field"/>
                </VBox>
                <HBox spacing="14.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="subtitle-text" style="-fx-font-size: 13px;" text="Expiry (MM/YY)"/>
                        <TextField fx:id="expiryField" promptText="12/26" styleClass="custom-text-field"/>
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="subtitle-text" style="-fx-font-size: 13px;" text="CVV"/>
                        <TextField fx:id="cvvField" promptText="123" styleClass="custom-text-field"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
                <Label fx:id="statusLabel" wrapText="true" style="-fx-font-size: 13px;"/>
                <Button mnemonicParsing="false" onAction="#handlePay"
                        maxWidth="Infinity" prefHeight="46.0"
                        style="-fx-font-size: 15px;"
                        styleClass="primary-button" text="🔒  Pay Securely"/>
            </VBox>

            <!-- ── RECEIPT (shown after payment) ── -->
            <VBox fx:id="receiptSuccessBox" alignment="TOP_CENTER" HBox.hgrow="ALWAYS" maxWidth="600.0" minWidth="370.0" spacing="14.0"
                  visible="false" managed="false" styleClass="food-card">
                <padding><Insets bottom="28.0" left="28.0" right="28.0" top="28.0"/></padding>

                <!-- Success header -->
                <Label style="-fx-font-size: 52px;" text="✅"/>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" text="Payment Successful!"/>

                <Separator/>

                <!-- Receipt body -->
                <Label styleClass="title-text" style="-fx-font-size: 16px;" text="— RECEIPT —"/>
                <Label fx:id="receiptRestaurantLabel" style="-fx-font-size: 14px; -fx-text-fill: #D70F64; -fx-font-weight: bold;" text=""/>
                <Label fx:id="receiptDateLabel" style="-fx-font-size: 12px; -fx-text-fill: #888;" text=""/>

                <ListView fx:id="receiptItemsListView" prefHeight="160.0"
                          style="-fx-background-color:transparent;-fx-control-inner-background:transparent;"/>

                <Separator/>
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="title-text" style="-fx-font-size: 14px;" text="Total Charged"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="receiptTotalLabel"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D70F64;" text="\$0.00"/>
                </HBox>
                <Label style="-fx-font-size: 11px; -fx-text-fill: #AAA;" text="Thank you for ordering! Your food is on its way 🚴"/>

                <Region prefHeight="10.0"/>
                <Button mnemonicParsing="false" onAction="#handleReturnHome"
                        maxWidth="Infinity" styleClass="primary-button" text="🏠  Return to Home"/>
            </VBox>

        </HBox>
    </center>
</BorderPane>
